{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Warning",
      "PIYA_API": "Information"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "https://piya.life"
  },
  "FacilityDirectory": {
    "Enabled": true,
    "RunOnStartup": true,
    "StartupDelaySeconds": 20,
    "SyncIntervalHours": 24,
    "CkanPackageApiUrl": "https://admin.opendata.az/api/3/action/package_show",
    "OverpassApiUrl": "https://overpass-api.de/api/interpreter"
  },
  "Database": {
    "AutoMigrate": false,
    "MigrateOnly": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "PIYA_API_Production",
    "Audience": "PIYA_Clients",
    "ExpirationMinutes": "15",
    "RefreshTokenExpirationDays": "7"
  },
  "Security": {
    "RequireHttps": true,
    "EnableCors": true,
    "AllowedOrigins": ["https://piya.life"],
    "QrSigningKey": "YOUR_QR_SIGNING_KEY",
    "PrescriptionSigningKey": "YOUR_PRESCRIPTION_SIGNING_KEY",
    "QrTokenExpiryMinutes": 5,
    "QrTokenCleanupDays": 30,
    "PasswordHashWorkFactor": 12,
    "MaxLoginAttempts": 3,
    "LockoutDurationMinutes": 30,
    "MaxConcurrentSessions": 3,
    "RefreshTokenConcurrencyGraceSeconds": 30
  },
  "ExternalApis": {
    "AzerbaijanPharmaceuticalRegistry": {
      "BaseUrl": "https://opendata.az/api/v1",
      "Endpoint": "/medications",
      "TimeoutSeconds": 30,
      "RetryAttempts": 3,
      "CacheDurationMinutes": 1440,
      "Enabled": true
    },
    "MedicationDatabase": {
      "Provider": "Azerbaijan",
      "SyncEnabled": true,
      "SyncIntervalHours": 24,
      "LastSyncTimestamp": null
    },
    "GoogleMaps": {
      "ApiKey": "REPLACE_WITH_GOOGLE_MAPS_API_KEY",
      "Enabled": false,
      "GeocodeEndpoint": "https://maps.googleapis.com/maps/api/geocode/json",
      "DistanceMatrixEndpoint": "https://maps.googleapis.com/maps/api/distancematrix/json"
    },
    "EmailService": {
      "Provider": "SMTP",
      "SmtpHost": "smtp.production.com",
      "SmtpPort": 587,
      "SmtpUsername": "REPLACE_WITH_SMTP_USERNAME",
      "SmtpPassword": "REPLACE_WITH_SMTP_PASSWORD",
      "FromEmail": "noreply@piya.az",
      "FromName": "PIYA Healthcare",
      "EnableSsl": true,
      "Enabled": true
    },
    "SmsService": {
      "Provider": "Twilio",
      "AccountSid": "REPLACE_WITH_TWILIO_SID",
      "AuthToken": "REPLACE_WITH_TWILIO_TOKEN",
      "FromPhoneNumber": "REPLACE_WITH_PHONE_NUMBER",
      "Enabled": true
    }
  },
  "Features": {
    "EnableTwoFactorAuth": true,
    "EnableQrCodeSystem": true,
    "EnableAppointmentSystem": true,
    "EnablePrescriptionSystem": true,
    "EnableAuditLogging": true,
    "EnableRateLimiting": true,
    "EnableCaching": true
  },
  "Firebase": {
    "Enabled": false,
    "ProjectId": "REPLACE_WITH_FIREBASE_PROJECT_ID",
    "CredentialsPath": "/run/secrets/firebase-service-account.json"
  },
  "ApplePush": {
    "Enabled": false,
    "TeamId": "REPLACE_WITH_APPLE_TEAM_ID",
    "KeyId": "REPLACE_WITH_APNS_KEY_ID",
    "BundleId": "com.piya.life",
    "CareBundleId": "com.piya.care",
    "PrivateKeyPath": "/run/secrets/AuthKey_APNS.p8",
    "UseSandbox": false
  },
  "RateLimiting": {
    "EnableGlobal": true,
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "Endpoints": {
      "QrGeneration": {
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      "QrValidation": {
        "PermitLimit": 20,
        "WindowSeconds": 60
      },
      "Authentication": {
        "PermitLimit": 3,
        "WindowSeconds": 300
      },
      "PublicSearch": {
        "PermitLimit": 30,
        "WindowSeconds": 60
      }
    }
  },
  "Caching": {
    "Provider": "Redis",
    "RedisConnectionString": "REPLACE_WITH_REDIS_CONNECTION_STRING",
    "DefaultExpirationMinutes": 60,
    "MedicationCacheMinutes": 1440,
    "PharmacyCacheMinutes": 60
  },
  "FileUpload": {
    "MaxFileSizeMB": 10,
    "MalwareScanning": {
      "Enabled": true,
      "Host": "clamav",
      "Port": 3310,
      "TimeoutSeconds": 30
    }
  }
}

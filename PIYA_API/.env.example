# ─────────────────────────────────────────────────────────────────────────────
# PIYA Healthcare API — Required Environment Variables
#
# ASP.NET Core maps environment variables to configuration using double-
# underscore (__) as the hierarchy separator on Linux/Docker:
#   Jwt__SecretKey  →  Jwt:SecretKey
#
# Copy this file to your deployment secrets manager (GitHub Secrets,
# Azure Key Vault, AWS SSM, Docker env file, etc.)
# NEVER commit real values to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
Frontend__BaseUrl=https://piya.life

# ── Database ──────────────────────────────────────────────────────────────────
# Full Npgsql connection string. Include SSL for production:
#   Host=db.example.com;Database=piya_db;Username=piya_user;Password=...,
#   Ssl Mode=Require;Trust Server Certificate=false
ConnectionStrings__DefaultConnection=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 chars. Generate: openssl rand -base64 64
Jwt__SecretKey=

# ── QR Token Signing ─────────────────────────────────────────────────────────
# Minimum 32 chars. Generate: openssl rand -base64 64
# Must be DIFFERENT from Jwt__SecretKey
Security__QrSigningKey=

# ── Prescription Token Signing ───────────────────────────────────────────────
# Minimum 32 chars. Must differ from both Jwt__SecretKey and QrSigningKey.
Security__PrescriptionSigningKey=

# ── SMTP (email) ─────────────────────────────────────────────────────────────
# Set Enabled=true only after supplying real credentials
ExternalApis__EmailService__Enabled=false
ExternalApis__EmailService__SmtpHost=smtp.gmail.com
ExternalApis__EmailService__SmtpPort=587
ExternalApis__EmailService__SmtpUsername=
ExternalApis__EmailService__SmtpPassword=
ExternalApis__EmailService__FromEmail=noreply@piya.az
ExternalApis__EmailService__FromName=PIYA Healthcare
ExternalApis__EmailService__EnableSsl=true

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# Set Enabled=true only after supplying real credentials
ExternalApis__SmsService__Enabled=false
ExternalApis__SmsService__AccountSid=
ExternalApis__SmsService__AuthToken=
ExternalApis__SmsService__FromPhoneNumber=

# ── Google Maps ───────────────────────────────────────────────────────────────
ExternalApis__GoogleMaps__Enabled=false
ExternalApis__GoogleMaps__ApiKey=

# ── Redis (optional — falls back to in-memory if empty) ──────────────────────
Caching__Provider=Memory
Caching__RedisConnectionString=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list handled by deployment config or override below:
# Cors__AllowedOrigins__0=https://piya.life
# Cors__AllowedOrigins__1=https://app.piya.life

# ── Object Storage ────────────────────────────────────────────────────────────
# Provider: "Local" (dev) | "S3" (AWS / MinIO / DO Spaces / Cloudflare R2)
# Keep Local for a persistent local volume, or switch to S3 after completing
# every non-optional Storage__S3__ value below.
Storage__Provider=Local
Storage__S3__BucketName=
Storage__S3__Region=us-east-1
Storage__S3__AccessKeyId=
Storage__S3__SecretAccessKey=
# ServiceUrl: leave empty for real AWS; set for S3-compatible endpoints:
#   MinIO:           http://localhost:9000
#   DigitalOcean:    https://<region>.digitaloceanspaces.com
#   Cloudflare R2:   https://<account-id>.r2.cloudflarestorage.com
Storage__S3__ServiceUrl=
Storage__S3__ForcePathStyle=false

{
  "info": {
    "name": "PIYA Healthcare API",
    "description": "Complete API collection for PIYA Backend - Healthcare Coordination Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:7001/api",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient@example.com\",\n  \"username\": \"patient123\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"phoneNumber\": \"+994501234567\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"role\": \"Patient\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"access_token\", jsonData.accessToken);",
                  "pm.environment.set(\"refresh_token\", jsonData.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"patient123\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"00000000-0000-0000-0000-000000000000\",\n  \"hospitalId\": \"00000000-0000-0000-0000-000000000000\",\n  \"scheduledAt\": \"2026-03-01T10:00:00Z\",\n  \"reasonForVisit\": \"Regular checkup\",\n  \"notes\": \"Patient has mild headaches\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/appointments",
              "host": ["{{base_url}}"],
              "path": ["appointments"]
            }
          }
        },
        {
          "name": "Get My Appointments",
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/appointments?page=1&pageSize=20",
              "host": ["{{base_url}}"],
              "path": ["appointments"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Emergency came up\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/appointments/:id/cancel",
              "host": ["{{base_url}}"],
              "path": ["appointments", ":id", "cancel"],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Prescriptions",
      "item": [
        {
          "name": "Create Prescription (Doctor Only)",
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"00000000-0000-0000-0000-000000000000\",\n  \"appointmentId\": \"00000000-0000-0000-0000-000000000000\",\n  \"diagnosis\": \"Mild hypertension\",\n  \"medications\": [\n    {\n      \"medicationId\": \"00000000-0000-0000-0000-000000000000\",\n      \"dosage\": \"10mg\",\n      \"frequency\": \"Once daily\",\n      \"duration\": \"30 days\",\n      \"instructions\": \"Take with food\",\n      \"quantity\": 30\n    }\n  ],\n  \"notes\": \"Follow-up in 1 month\",\n  \"validityDays\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/prescriptions",
              "host": ["{{base_url}}"],
              "path": ["prescriptions"]
            }
          }
        },
        {
          "name": "Get Prescription QR Code",
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/prescriptions/:id/qr",
              "host": ["{{base_url}}"],
              "path": ["prescriptions", ":id", "qr"],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pharmacies",
      "item": [
        {
          "name": "Search by Location",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pharmacies/search?latitude=40.4093&longitude=49.8671&radiusKm=5",
              "host": ["{{base_url}}"],
              "path": ["pharmacies", "search"],
              "query": [
                {
                  "key": "latitude",
                  "value": "40.4093"
                },
                {
                  "key": "longitude",
                  "value": "49.8671"
                },
                {
                  "key": "radiusKm",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Search by Medication",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/pharmacies/search/medication?medicationId=00000000-0000-0000-0000-000000000000&latitude=40.4093&longitude=49.8671",
              "host": ["{{base_url}}"],
              "path": ["pharmacies", "search", "medication"],
              "query": [
                {
                  "key": "medicationId",
                  "value": "00000000-0000-0000-0000-000000000000"
                },
                {
                  "key": "latitude",
                  "value": "40.4093"
                },
                {
                  "key": "longitude",
                  "value": "49.8671"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "QR Validation (Pharmacist)",
      "item": [
        {
          "name": "Scan QR Code",
          "request": {
            "auth": {
              "type": "bearer"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"qr_token_here\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/qr/scan",
              "host": ["{{base_url}}"],
              "path": ["qr", "scan"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Basic Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Detailed Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health/detailed",
              "host": ["{{base_url}}"],
              "path": ["health", "detailed"]
            }
          }
        }
      ]
    }
  ]
}
